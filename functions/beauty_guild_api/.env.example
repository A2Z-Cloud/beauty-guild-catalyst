# Beauty Guild API environment template
# Copy to .env for local development. Keep real values out of this file.
# Catalyst deployment secrets should be configured in the Catalyst console.

CRM_CONNECTION_NAME=zohocrm
CRM_API_DOMAIN=https://www.zohoapis.eu

LOQATE_API_KEY=replace_with_loqate_key
LOQATE_API_BASE_URL=https://api.addressy.com
LOQATE_COUNTRY_FILTER=GBR
LOQATE_MAX_RESULTS=10

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=replace_with_supported_stripe_api_version
STRIPE_CURRENCY=gbp
STRIPE_PRICE_ACCREDITATION=price_replace_me
STRIPE_PRICE_ASSOCIATE_MEMBERSHIP=price_replace_me
STRIPE_SUCCESS_URL=https://beautyguild-20117268527.development.catalystserverless.eu/app/index.html?payment=success
STRIPE_CANCEL_URL=https://beautyguild-20117268527.development.catalystserverless.eu/app/index.html?payment=cancelled
STRIPE_WEBHOOK_PATH=/stripe/webhook

ACCREDITATION_FEE_GBP=354.00
ASSOCIATE_MEMBERSHIP_FEE_GBP=55.00
ACCREDITATION_WITH_MEMBERSHIP_GBP=409.00
VAT_RATE_PERCENT=20
